# Meta Model API key (dev.meta.ai > API keys). Never commit the real .env.
MODEL_API_KEY=
# Hard cap on Meta API spend for all runs, in USD (the meter refuses calls beyond it).
ATLAS_BUDGET_USD=120
# Optional overrides
# ATLAS_SPARK_MODEL=muse-spark-1.3
# ATLAS_WONDER_MODEL=muse-wonder-1.0
# Optional: Mapillary client token (street-level photos, a third independent source)
MAPILLARY_TOKEN=
# Optional: Muse Spark Open (open weights) on Baseten, for --lm open runs
BASETEN_API_KEY=
# ATLAS_OPEN_BUDGET_USD=90
